# --- Server ---
HOST=0.0.0.0
PORT=8006
LOG_LEVEL=INFO
LOG_JSON=true

# --- Service-to-service auth ---
# Shared secret. Must equal the AI Learning Assistant's MCP_SERVER_AUTH_TOKEN.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=change-me

# --- Web search ---
SEARCH_PROVIDER=tavily
WEB_SEARCH_DEFAULT_MAX_RESULTS=5
WEB_SEARCH_MAX_RESULTS_LIMIT=10
WEB_SEARCH_TIMEOUT_SECONDS=15.0
WEB_SEARCH_PROVIDER_MAX_RETRIES=2
WEB_SEARCH_RATE_LIMIT_PER_MIN=60

# --- Provider: Tavily (credentials live ONLY in this service) ---
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVILY_SEARCH_DEPTH=basic

# --- PDF generation ---
PDF_GENERATION_ENABLED=false
PDF_RENDERER=weasyprint
PDF_RENDER_TIMEOUT_SECONDS=20
PDF_UPLOAD_TIMEOUT_SECONDS=15
PDF_MARKDOWN_MAX_CHARS=50000
PDF_MAX_PAGE_COUNT=50
PDF_URL_EXPIRES_SECONDS=3600
PDF_GENERATION_RATE_LIMIT_PER_MIN=20

# --- Object storage (S3-compatible: Cloudflare R2 in prod, MinIO locally) ---
# Local MinIO   : S3_ENDPOINT_URL=http://localhost:9000                     S3_REGION=us-east-1 S3_ENSURE_BUCKET=true
# Cloudflare R2 : S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com  S3_REGION=auto  S3_ENSURE_BUCKET=false
# S3_PUBLIC_ENDPOINT_URL signs the download URL; leave empty to reuse S3_ENDPOINT_URL.
S3_ENDPOINT_URL=http://localhost:9000
S3_PUBLIC_ENDPOINT_URL=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=learning-documents
S3_REGION=us-east-1
S3_ADDRESSING_STYLE=path
S3_ENSURE_BUCKET=false
